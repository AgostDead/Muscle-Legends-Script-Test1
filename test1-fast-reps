-- MAIN TAB
local MainTab = Window:Tab({ Title = "Main", Icon = "user" })
MainTab:Section({ Title = "Movement" })

MainTab:Slider({
    Title = "WalkSpeed",
    Icon = "zap",
    Value = { Min = 16, Max = 500, Default = 16 },
    Step = 1,
    Callback = function(value)
        local char = LocalPlayer.Character
        if char then
            local hum = char:FindFirstChildOfClass("Humanoid")
            if hum then hum.WalkSpeed = value end
        end
    end
})

MainTab:Slider({
    Title = "JumpPower",
    Icon = "arrow-up",
    Value = { Min = 50, Max = 1500, Default = 50 },
    Step = 1,
    Callback = function(value)
        local char = LocalPlayer.Character
        if char then
            local hum = char:FindFirstChildOfClass("Humanoid")
            if hum then hum.JumpPower = value end
        end
    end
})

MainTab:Toggle({
    Title = "Infinite Jump",
    Icon = "arrow-up-circle",
    Value = false,
    Callback = function(state)
        _G.InfJump = state
    end,
})

UserInputService.JumpRequest:Connect(function()
    if _G.InfJump then
        local char = LocalPlayer.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if hum then hum:ChangeState(Enum.HumanoidStateType.Jumping) end
    end
end)

MainTab:Toggle({
    Title = "Anti Fling",
    Icon = "shield",
    Value = false,
    Callback = function(state)
        local function applyAntiFling(char)
            if not char then return end
            local hrp = char:FindFirstChild("HumanoidRootPart")
            if not hrp then return end
            if state then
                if not hrp:FindFirstChild("AntiFling_BV") then
                    local bv = Instance.new("BodyVelocity")
                    bv.Name = "AntiFling_BV"
                    bv.MaxForce = Vector3.new(1e5, 0, 1e5)
                    bv.Velocity = Vector3.zero
                    bv.Parent = hrp
                end
            else
                local ex = hrp:FindFirstChild("AntiFling_BV")
                if ex then ex:Destroy() end
            end
        end
        applyAntiFling(LocalPlayer.Character)
        LocalPlayer.CharacterAdded:Connect(function(c)
            task.wait(0.5)
            applyAntiFling(c)
        end)
    end,
})

-- FARMING TAB
local FarmTab = Window:Tab({ Title = "Farming", Icon = "swords" })
FarmTab:Section({ Title = "Auto Strength" })

local isFarming = false
local farmConnection = nil
FarmTab:Toggle({
    Title = "Ultimate Fast Strength",
    Desc = "Fast strength farm",
    Icon = "flame",
    Value = false,
    Callback = function(state)
        isFarming = state
        if isFarming then
            if farmConnection then farmConnection:Disconnect() end
            farmConnection = RunService.Heartbeat:Connect(function()
                task.wait(0.1)
                if not isFarming then return end
                pcall(function()
                    if muscleEvent then muscleEvent:FireServer("rep") end
                end)
            end)
            PainKillersUI:Notify({Title = "Auto Strength", Content = "Enabled", Duration = 3, Icon = "play"})
        else
            if farmConnection then farmConnection:Disconnect() farmConnection = nil end
            PainKillersUI:Notify({Title = "Auto Strength", Content = "Disabled", Duration = 3, Icon = "square"})
        end
    end,
})

FarmTab:Section({ Title = "Auto Exercises" })
local exerciseNames = {"Weight", "Pushups", "Handstands", "Situps", "Punch"}
for _, name in ipairs(exerciseNames) do
    local key = "AutoExercise_" .. name
    FarmTab:Toggle({
        Title = "Auto " .. name,
        Icon = "activity",
        Value = false,
        Callback = function(state)
            _G[key] = state
            if state then
                task.spawn(function()
                    while _G[key] do
                        local bp = LocalPlayer:FindFirstChild("Backpack")
                        if bp then
                            local tool = bp:FindFirstChild(name)
                            if tool and LocalPlayer.Character then
                                pcall(function()
                                    local hum = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
                                    if hum then hum:EquipTool(tool) end
                                end)
                            end
                            pcall(function()
                                if muscleEvent then muscleEvent:FireServer("rep") end
                            end)
                        end
                        task.wait(0.1)
                    end
                end)
            end
        end,
    })
end

FarmTab:Section({ Title = "Auto Rebirth" })
FarmTab:Toggle({
    Title = "Auto Rebirth",
    Desc = "Automatic rebirth",
    Icon = "refresh-cw",
    Value = false,
    Callback = function(state)
        _G.AutoRebirth = state
        if state then
            task.spawn(function()
                while _G.AutoRebirth do
                    pcall(function()
                        if rEvents and rEvents:FindFirstChild("rebirthRemote") then
                            rEvents.rebirthRemote:InvokeServer("rebirthRequest")
                        end
                    end)
                    task.wait(0.5)
                end
            end)
            PainKillersUI:Notify({Title = "Auto Rebirth", Content = "Enabled", Duration = 3, Icon = "play"})
        else
            PainKillersUI:Notify({Title = "Auto Rebirth", Content = "Disabled", Duration = 3, Icon = "square"})
        end
    end,
})

